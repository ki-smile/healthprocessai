# Load required libraries
library(tm)
library(lsa)
# Sample text data
texts <- c(
"Machine learning algorithms have revolutionized the field of artificial intelligence by enabling computers to learn patterns from data without explicit programming. These algorithms can identify complex relationships in datasets and make predictions or classifications based on learned patterns. Popular machine learning techniques include supervised learning, unsupervised learning, and reinforcement learning, each serving different purposes in data analysis and pattern recognition.",
"Deep learning represents a subset of machine learning that utilizes artificial neural networks with multiple layers to process and analyze complex data structures. These neural networks can automatically extract hierarchical features from raw data, making them particularly effective for tasks such as image recognition, natural language processing, and speech recognition. The depth of these networks allows them to capture intricate patterns that traditional machine learning methods might miss.",
"Climate change continues to pose significant challenges to global ecosystems and human societies worldwide. Rising temperatures, changing precipitation patterns, and extreme weather events are affecting agricultural productivity, water resources, and biodiversity. Scientists emphasize the urgent need for coordinated international efforts to reduce greenhouse gas emissions and implement sustainable practices to mitigate the long-term impacts of environmental degradation on our planet's future."
)
# Create a Corpus
corpus <- Corpus(VectorSource(texts))
# Data Preprocessing
corpus <- tm_map(corpus, content_transformer(tolower))
corpus <- tm_map(corpus, removePunctuation)
corpus <- tm_map(corpus, removeNumbers)
corpus <- tm_map(corpus, removeWords, stopwords("en"))
corpus <- tm_map(corpus, stripWhitespace)
# Create Term-Document Matrix
tdm <- TermDocumentMatrix(corpus)
# Convert TDM to matrix
tdm_matrix <- as.matrix(tdm)
tdm_matrix
lsa_space <- lsa(tdm_matrix)
lsa_space
similarity_matrix <- cosine(t(lsa_space$dk %*% diag(lsa_space$sk)))
print(similarity_matrix)
